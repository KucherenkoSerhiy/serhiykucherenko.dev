---
import Base from '../../layouts/Base.astro';
import { articles, startHere } from '../../data/articles';
import { milestones } from '../../data/shiplog';

type Row = {
  date: string;
  kind: 'article' | 'ship' | 'milestone';
  title: string;
  sub: string;
  metric: string;
  metricTone: 'accent' | 'ok';
  url?: string;
  external?: boolean;
  mirrors?: { where: string; url: string }[];
  series?: string;
};

const rows: Row[] = [
  ...articles.map(
    (a): Row => ({
      date: a.date,
      kind: 'article',
      title: a.title,
      sub: `read on ${a.where} ↗`,
      metric: a.metric,
      metricTone: 'accent',
      url: a.url,
      external: true,
      mirrors: a.also,
      series: a.series,
    })
  ),
  ...milestones.map(
    (m): Row => ({
      date: m.date,
      kind: m.kind,
      title: m.title,
      sub: m.sub,
      metric: m.metric,
      metricTone: m.metricTone,
      url: m.href,
      external: !!m.href,
    })
  ),
].sort((a, b) => (a.date < b.date ? 1 : -1));

const kindLabel: Record<Row['kind'], string> = {
  article: 'wrote',
  ship: 'shipped',
  milestone: 'milestone',
};
const picks = startHere
  .map((p) => ({ ...p, article: articles.find((a) => a.title === p.title) }))
  .filter((p) => p.article);

const fmt = (iso: string) =>
  new Date(iso + 'T00:00:00Z')
    .toLocaleDateString('en-US', { month: 'short', day: '2-digit', timeZone: 'UTC' })
    .toLowerCase();
---

<Base title="Ship log" description="Articles, releases and milestones, newest first. Articles link out to where they were published.">
  <h1>ship log</h1>
  <p class="eyebrow" style="margin-top:0.5rem;">everything that shipped or changed — newest first</p>

  <div class="start">
    <p class="eyebrow">start here · three of {articles.length}</p>
    <div class="picks">
      {
        picks.map((p) => (
          <a class="pick" href={p.article!.url} target="_blank" rel="noopener noreferrer">
            <span class="pk-why">{p.why}</span>
            <span class="pk-title">{p.article!.title} ↗</span>
            <span class="pk-metric">{p.article!.metric}</span>
          </a>
        ))
      }
    </div>
  </div>

  <div class="legend">
    <span><span class="n-article"></span>wrote</span>
    <span><span class="n-ship"></span>shipped</span>
    <span><span class="n-milestone"></span>milestone</span>
  </div>

  <div class="timeline">
    {
      rows.map((r, i) => {
        const Wrapper = r.url ? 'a' : 'div';
        const linkAttrs = r.url
          ? {
              href: r.url,
              ...(r.external ? { target: '_blank', rel: 'noopener noreferrer' } : {}),
            }
          : {};
        return (
          <>
            <div class="tl-when">
              <div class="d">{fmt(r.date)}</div>
              <div class={`k k-${r.kind}`}>{kindLabel[r.kind]}</div>
            </div>
            <div class="tl-rail">
              <div class="line" style={i === rows.length - 1 ? 'height:1.8rem' : ''}></div>
              <div class={`node n-${r.kind}`}></div>
            </div>
            <div class="tl-body">
              <Wrapper {...linkAttrs} class={r.url ? '' : 'static'}>
                {r.metric && (
                  <div class={`tl-metric m-${r.metricTone === 'ok' ? 'ship' : 'article'}`}>{r.metric}</div>
                )}
                <div class="tl-title">{r.title}</div>
                <div class="tl-sub">
                  {r.series && <span class="tl-series">{r.series} · </span>}
                  {r.sub}
                </div>
              </Wrapper>
              {
                r.mirrors && r.mirrors.length > 0 && (
                  <div class="tl-mirrors">
                    also on{' '}
                    {r.mirrors.map((m, j) => (
                      <>
                        {j > 0 && ' · '}
                        <a href={m.url} target="_blank" rel="noopener noreferrer">
                          {m.where} ↗
                        </a>
                      </>
                    ))}
                  </div>
                )
              }
            </div>
          </>
        );
      })
    }
  </div>
</Base>

<style>
  .start {
    margin: 1.5rem 0 1.75rem;
  }
  .picks {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin-top: 0.6rem;
  }
  @media (max-width: 640px) {
    .picks {
      grid-template-columns: 1fr;
    }
  }
  .pick {
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.8rem 0.9rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .pick:hover {
    border-color: var(--accent);
  }
  .pk-why {
    color: var(--dim);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .pk-title {
    color: var(--bright);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .pk-metric {
    color: var(--accent);
    font-size: 0.8rem;
  }
  .tl-series {
    color: var(--accent-dim);
  }
</style>
