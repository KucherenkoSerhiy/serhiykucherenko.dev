---
import Base from '../layouts/Base.astro';
import { foundation, towers } from '../data/castle';

const shipped = towers.reduce(
  (n, t) => n + t.bricks.filter((b) => b.state === 'shipped').length,
  0
);
// Parked bricks were built but never snapped into the structure — they sit in the yard.
const yard = towers.flatMap((t) =>
  t.bricks.filter((b) => b.state === 'parked').map((b) => ({ ...b, from: t.name }))
);
const standing = towers.map((t) => ({ ...t, bricks: t.bricks.filter((b) => b.state !== 'parked') }));
---

<Base
  title="Project map"
  description="The brick castle: every shipped thing is a brick. Bricks stack into projects, projects stand on shared foundations."
>
  <div class="castle-view">
    <header class="castle-head">
      <h1>Project map</h1>
      <p class="eyebrow">
        every shipped thing is a brick · {shipped} laid so far · the castle grows as things ship
      </p>
    </header>

    <div class="legend">
      <span><span class="sw sw-ok"></span>shipped</span>
      <span><span class="sw sw-amber"></span>runs on someone else's metal</span>
      <span><span class="sw sw-dash"></span>not built yet</span>
      <span><span class="sw sw-parked"></span>built, parked</span>
    </div>

    <div class="castle" role="img" aria-label={`Project map: ${towers.map((t) => `${t.name} (${t.status}, ${t.bricks.length} bricks)`).join('; ')}, all standing on shared infrastructure`}>
      <div class="towers">
        {
          standing.map((t) => (
            <div class={`tower tower-${t.status}`}>
              <div class="battlement" aria-hidden="true">
                {Array.from({ length: 5 }).map(() => <span></span>)}
              </div>
              <div class="tower-cap">
                {
                  t.href ? (
                    t.href.startsWith('http') ? (
                      <a href={t.href} target="_blank" rel="noopener noreferrer">{t.name}</a>
                    ) : (
                      <a href={t.href}>{t.name}</a>
                    )
                  ) : (
                    <span>{t.name}</span>
                  )
                }
                <span class={`tower-status s-${t.status}`}>{t.status}</span>
              </div>
              <div class="stack">
                {
                  [...t.bricks].reverse().map((b) => (
                    <div class={`cb cb-${b.state}${b.wide ? ' cb-wide' : ''}`}>
                      <span class="studs" aria-hidden="true">
                        <span></span>
                        <span></span>
                      </span>
                      <span class="cb-label">{b.label}</span>
                      {b.note && <span class="cb-note">{b.note}</span>}
                    </div>
                  ))
                }
              </div>
            </div>
          ))
        }
      </div>

      <div class="ground">
        <span class="ground-label">foundation</span>
        <div class="ground-bricks">
          {
            foundation.map((b) => (
              <div class="cb cb-dep">
                <span class="studs" aria-hidden="true">
                  <span></span>
                  <span></span>
                </span>
                <span class="cb-label">{b.label}</span>
                {b.note && <span class="cb-note">{b.note}</span>}
              </div>
            ))
          }
        </div>
      </div>
    </div>

    {
      yard.length > 0 && (
        <div class="yard">
          <span class="ground-label">the yard — built, measured, not snapped in</span>
          <div class="ground-bricks">
            {yard.map((b) => (
              <div class="cb cb-parked">
                <span class="studs" aria-hidden="true">
                  <span />
                  <span />
                </span>
                <span class="cb-label">{b.label}</span>
                {b.note && <span class="cb-note">{b.note}</span>}
                <span class="cb-from">{b.from}</span>
              </div>
            ))}
          </div>
        </div>
      )
    }

    <p class="meta castle-note">
      A brick is laid when something actually runs, not when it is planned. Dashed bricks are
      the next thing being scoped; parked ones were built, measured, and left out on purpose.
    </p>
  </div>
</Base>

<style>
  .castle-view {
    padding-bottom: 1rem;
  }
  .castle-head h1 {
    margin-bottom: 0.3rem;
  }
  .castle-head .eyebrow {
    margin-bottom: 1rem;
  }

  .sw {
    width: 14px;
    height: 10px;
    border-radius: 2px;
    border: 1.5px solid;
    display: inline-block;
  }
  .sw-ok {
    border-color: var(--ok);
    background: color-mix(in srgb, var(--ok) 12%, transparent);
  }
  .sw-amber {
    border-color: var(--accent);
  }
  .sw-dash {
    border-style: dashed;
    border-color: var(--dim);
  }
  .sw-parked {
    border-color: var(--dim);
    background: color-mix(in srgb, var(--dim) 18%, transparent);
  }

  .castle {
    margin: 0.5rem 0 1.25rem;
  }

  .towers {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .tower {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    flex: 1 1 190px;
    max-width: 260px;
  }

  .battlement {
    display: flex;
    justify-content: space-between;
    padding: 0 6px;
  }
  .battlement span {
    width: 14%;
    height: 9px;
    background: var(--line);
    border-radius: 2px 2px 0 0;
  }
  .tower-live .battlement span {
    background: color-mix(in srgb, var(--ok) 55%, var(--line));
  }
  .tower-scoping .battlement span {
    background: transparent;
    border: 1px dashed var(--line);
    border-bottom: none;
  }

  .tower-cap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    border: 1px solid var(--line);
    border-radius: 3px 3px 0 0;
    padding: 0.4rem 0.6rem;
    font-size: 0.78rem;
    background: var(--panel);
  }
  .tower-cap a,
  .tower-cap span:first-child {
    color: var(--bright);
    font-weight: 700;
    text-decoration: none;
  }
  .tower-cap a:hover {
    color: var(--accent);
  }
  .tower-status {
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .s-live {
    color: var(--ok);
  }
  .s-scoping {
    color: var(--accent);
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding-top: 5px;
  }

  .cb {
    position: relative;
    border: 1.5px solid var(--dim);
    border-radius: 3px;
    padding: 0.45rem 0.6rem;
    font-size: 0.74rem;
    line-height: 1.35;
  }
  .cb .studs {
    position: absolute;
    top: -4px;
    left: 10px;
    display: flex;
    gap: 7px;
  }
  .cb .studs span {
    width: 10px;
    height: 5px;
    border-radius: 2px 2px 0 0;
  }
  .cb-label {
    display: block;
    color: var(--bright);
    font-weight: 700;
  }
  .cb-note {
    display: block;
    color: color-mix(in srgb, var(--dim) 40%, var(--fg));
    font-size: 0.68rem;
  }

  .cb-shipped {
    border-color: var(--ok);
    background: color-mix(in srgb, var(--ok) 10%, transparent);
  }
  .cb-shipped .studs span {
    background: var(--ok);
  }
  .cb-dep {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }
  .cb-dep .studs span {
    background: var(--accent);
  }
  .cb-dep .cb-label {
    color: var(--accent);
  }
  .cb-planned {
    border-style: dashed;
    border-color: var(--dim);
  }
  .cb-planned .studs span {
    background: color-mix(in srgb, var(--dim) 55%, transparent);
  }
  .cb-planned .cb-label {
    color: color-mix(in srgb, var(--dim) 30%, var(--fg));
  }
  .cb-parked {
    border-color: var(--dim);
    background: color-mix(in srgb, var(--dim) 12%, transparent);
  }
  .cb-parked .studs span {
    background: var(--dim);
  }
  .cb-parked .cb-label {
    color: color-mix(in srgb, var(--dim) 25%, var(--fg));
  }
  .cb-wide {
    margin: 0 -0.5rem;
  }

  .ground {
    margin-top: 5px;
    border-top: 2px solid var(--line);
    padding-top: 0.6rem;
  }
  .ground-label {
    display: block;
    font-size: 0.62rem;
    color: var(--dim);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.45rem;
  }
  .ground-bricks {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .ground-bricks .cb {
    flex: 1 1 130px;
  }

  .yard {
    margin: 1.25rem 0;
    border: 1px dashed var(--line);
    border-radius: 6px;
    padding: 0.85rem 1rem;
  }
  .cb-from {
    display: block;
    color: var(--dim);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: 0.2rem;
  }

  .castle-note {
    font-style: italic;
    max-width: 60ch;
  }

  @media (max-width: 560px) {
    .tower {
      max-width: none;
      flex-basis: 100%;
    }
  }
</style>
