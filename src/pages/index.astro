---
import Base from '../layouts/Base.astro';
import { articles } from '../data/articles';

const latest = [...articles].sort((a, b) => (a.date < b.date ? 1 : -1))[0];
const parts = (latest?.metric ?? '').split('→').map((s) => s.trim());
---

<Base>
  <script
    type="application/ld+json"
    slot="head"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Serhiy Kucherenko',
      url: 'https://serhiykucherenko.dev',
      jobTitle: 'Software engineer who builds AI systems',
      address: { '@type': 'PostalAddress', addressLocality: 'Barcelona', addressCountry: 'ES' },
      knowsAbout: ['RAG systems', 'LLM evaluation', 'AI agents', 'Python', 'TypeScript', 'SEPA payments', 'ISO 20022', '.NET'],
      sameAs: ['https://github.com/KucherenkoSerhiy', 'https://www.linkedin.com/in/serhiy-kucherenko/'],
    })}
  />

  <section class="hero">
    <div class="hero-inner">

      <h1 class="who">
        Serhiy Kucherenko <span class="sep">·</span> software engineer who builds AI systems
        <span class="sep">·</span> <span class="where">Barcelona, relocating to Warsaw</span>
      </h1>

      <p class="eyebrow">fig.0 — the operator</p>
      <div class="opmap">
        <div class="op-node">
          <div class="t">Backend engineering</div>
          <div class="s">10y · banking · medical · industrial</div>
        </div>
        <div class="op-link"></div>
        <div class="op-node now">
          <div class="t">AI systems, from scratch</div>
          <div class="s">evals · rag · agents · cost</div>
        </div>
        <div class="op-link"></div>
        <div class="op-node next">
          <div class="t">your system</div>
          <div class="s">built the same way</div>
        </div>
      </div>

      {
        latest && (
          <>
            <p class="eyebrow" style="margin-top:2rem;">
              latest · {latest.date} · {articles.length} articles, weekly since jul 2026
            </p>
            <a href={latest.url} target="_blank" rel="noopener noreferrer" style="text-decoration:none;">
              <div class="metricline">
                {parts.length === 2 ? (
                  <>
                    <span class="big">{parts[0]}</span>
                    <span class="arrow">→</span>
                    <span class="big ok">{parts[1]}</span>
                  </>
                ) : (
                  <span class="big">{parts[0]}</span>
                )}
              </div>
              <div style="color:var(--fg);margin-top:0.4rem;">
                {latest.title} <span style="color:var(--accent)">↗</span>
              </div>
              <div class="meta" style="margin-top:0.2rem;">read on {latest.where}</div>
            </a>
          </>
        )
      }

      <div class="doors">
        <a class="door" href="/contact/">
          <span class="cmd">&gt; contact</span>
          <span class="sub">evals · rag · agents · llm cost control</span>
        </a>
        <a class="door" href="/lab/">
          <span class="cmd">&gt; cd lab/</span>
          <span class="sub">questions being tested, answers included</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .who {
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--fg);
    margin: 0 0 1.5rem;
    line-height: 1.5;
  }
  .who .sep {
    color: var(--dim);
    margin: 0 0.2rem;
  }
  .who .where {
    color: var(--dim);
  }
</style>
